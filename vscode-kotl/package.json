{
  "name": "kotl-status",
  "displayName": "Kotl",
  "description": "The lab's FPGA board queue (Kotl) in the status bar: who holds each board, time against ETA, your jobs, notices.",
  "version": "1.0.0",
  "publisher": "kotl",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kotl.top",
        "title": "Kotl: Open kotl top"
      },
      {
        "command": "kotl.refresh",
        "title": "Kotl: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kotl.notices",
        "title": "Kotl: Show notices"
      }
    ],
    "configuration": {
      "title": "Kotl",
      "properties": {
        "kotl.ssh": {
          "type": "string",
          "default": "",
          "description": "Leave empty on the workstation. On your own PC: the workstation's ssh name (kotl-client/install.sh sets it in ~/.kotl-client/ssh)."
        },
        "kotl.refreshSeconds": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "How often to refresh (seconds). On the workstation it reads the Kotl daemon's status file, so 1 s is cheap; over ssh it is at least 5 s."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kotl",
          "title": "Kotl",
          "icon": "media/kotl.svg"
        }
      ]
    },
    "views": {
      "kotl": [
        {
          "id": "kotl.status",
          "name": "Boards and queue"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kotl.refresh",
          "when": "view == kotl.status",
          "group": "navigation"
        },
        {
          "command": "kotl.top",
          "when": "view == kotl.status"
        }
      ]
    }
  }
}
