# managed by kotl (deploy/kotl/install.sh)
# The Kotl daemon (kotld): Kotl's one always-running process. It runs small tasks on their own
# intervals; the first writes /run/kotl/status.json every second for kotl status, kotl top, the
# Claude band and the VS Code extension. `kotl daemon` shows its state.
[Unit]
Description=Kotl daemon (kotld)
After=network-online.target slurmctld.service

[Service]
Type=simple
User=kotl
ExecStart=/opt/kotl/launch daemon
Restart=always
RestartSec=2
RuntimeDirectory=kotl
RuntimeDirectoryMode=0755
Nice=5

[Install]
WantedBy=multi-user.target
